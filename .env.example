# Salin file ini menjadi `.env` dan isi nilai sesungguhnya. `.env` sudah di-gitignore — jangan pernah commit kredensial asli.

# ── Supabase (PostgreSQL) — sumber data mentah/production ──────────────────────
# Project Settings > Database > Connection string di dashboard Supabase.
# Gunakan role read-only jika tersedia (least-privilege) untuk kebutuhan audit/baca skema saat ini.
SUPABASE_DB_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# ── MLflow (model registry, dipakai churn_prediction.inference) ────────────────
# Registry resmi sejak Milestone 2.1 -- direct-access ke Postgres Supabase, TANPA
# proses `mlflow server` (lihat milestones/2.1-fondasi-orchestrator-model-registry/
# decisions.md Keputusan #2). Role `mlflow_registry` least-privilege, scoped ke
# schema `mlflow` saja (Keputusan #4) -- BUKAN role SUPABASE_DB_URL di atas.
# Default kalau tidak diset: sqlite:///mlruns.db (pola lama M1.5, hanya untuk dev
# lokal tanpa akses Supabase).
MLFLOW_TRACKING_URI=postgresql://mlflow_registry.<project-ref>:<password>@<host>:<port>/postgres

# ── MLflow Artifact Store (Supabase Storage, S3-compatible) ────────────────────
# Project Settings > Storage > S3 Access Keys di dashboard Supabase. Bucket
# terpisah khusus artifact model (mis. `mlflow-artifacts`), TIDAK reuse key lain.
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
MLFLOW_S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
MLFLOW_ARTIFACT_BUCKET=<nama-bucket-mlflow-artifacts>

# ── Prefect Cloud (orchestrator, Managed work pool) ─────────────────────────────
# Profile > API Keys di app.prefect.cloud. Hanya nilai key-nya saja (bukan
# perintah `prefect cloud login -k ...` lengkap). PREFECT_API_URL didapat dari
# `prefect cloud workspace set --workspace <handle>` lalu baca
# ~/.prefect/profiles.toml, ATAU dari URL API workspace di app.prefect.cloud.
PREFECT_API_KEY=<prefect-api-key>
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>

# ── Batch scoring DAG (Milestone 2.5) — role least-privilege terpisah ──────────
# Provisioning lewat infra/sql/2.5_batch_scoring_roles.sql. batch_reader:
# SELECT-only ke telco_customers_source. batch_writer: SELECT+INSERT-only ke
# predictions.batch_predictions (append-only, tanpa UPDATE/DELETE).
BATCH_READER_DB_URL=postgresql://batch_reader.<project-ref>:<password>@<host>:<port>/postgres
BATCH_WRITER_DB_URL=postgresql://batch_writer.<project-ref>:<password>@<host>:<port>/postgres

# ── Gerbang kualitas data harian (Milestone 2.4) — role least-privilege ────────
# Provisioning lewat infra/sql/2.4_quality_gate_role.sql. Role quality_gate:
# SELECT+INSERT-only ke quality.gate_run_history (append-only).
QUALITY_GATE_DB_URL=postgresql://quality_gate.<project-ref>:<password>@<host>:<port>/postgres

# ── Exporter status pipeline batch (Milestone 3.5) — role least-privilege ──────
# Provisioning lewat infra/sql/3.5_monitoring_reader_role.sql. Role monitoring_reader:
# SELECT-only ke quality.gate_run_history + predictions.batch_predictions (dipakai
# orchestration/monitoring/pipeline_health_exporter.py, TIDAK bisa INSERT/UPDATE/DELETE).
MONITORING_READER_DB_URL=postgresql://monitoring_reader.<project-ref>:<password>@<host>:<port>/postgres
